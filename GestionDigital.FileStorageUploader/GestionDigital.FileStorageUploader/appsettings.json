{
  "Serilog": {
    "Using": [],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}  - {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/ApplicationLog.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}  - {Message}{NewLine}{Exception}",
          "fileSizeLimitBytes": "10485760",
          "rollOnFileSizeLimit": "true"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DbConnection": "Server =190.183.61.172,1433; Database = GD_FileStorageFM; persist security info=True;user id=FM;password=FM_123456;TrustServerCertificate=true;"
  },
  "CloudStorageSettings": {
    "StorageKey":"C:\\Users\\devnote\\git\\GestionDigital.FileStorage\\GestionDigital.FileStorage.Api\\Keys\\files-cloud-storage-key.json",
    "RequestTimeoutInSeconds": 600,// Timeout maximo por request a Google Cloud Storage, en segundos.
    "UploadRetries": 3,// Cantidad de reintentos si falla la subida de un recibo.
    "UploadRetryDelayInSeconds": 10// Espera entre reintentos de subida, en segundos.
  },
  "StorageSettings": {
    "DefaultStorageTypeId": "file_storage_prd_bucket_01"
  },
  "DeleteLocalFileSettings": {
    "BatchSize": 1000// Cantidad de recibos locales a borrar por batch.
  },
  "CronJobs": {
    "UploaderWorker": {
      "enable": true,
      "schudulers": [
